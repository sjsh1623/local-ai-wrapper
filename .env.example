# ─────────────────────────────────────────────────────────────
#  morningmate-alert — copy to .env and fill in.  자세한 설명은 README 참고.
# ─────────────────────────────────────────────────────────────

# Language for Flow comments, alerts, errors and logs.  ko | en
LOCALE=ko
LOG_LEVEL=info
PORT=8080

# Keys accepted on X-API-Key for /v1/* and the console.  Comma separated.
API_KEYS=change-me

# ── SigNoz inbound ───────────────────────────────────────────
# The SigNoz webhook channel can only send HTTP Basic Auth — no custom headers.
SIGNOZ_WEBHOOK_USER=signoz
SIGNOZ_WEBHOOK_PASS=change-me
# An alert must carry this label set to "true" or it is ignored.
SIGNOZ_REQUIRE_LABEL=autofix
SIGNOZ_SEVERITIES=critical,error
# Fallback mapping for alerts that cannot carry labels.
ROUTES_FILE=./routes.yml
# resolved alerts: ignore | cancel
SIGNOZ_ON_RESOLVED=ignore

# 에이전트가 알럿 뒤의 로그·트레이스를 직접 읽게 하려면 SigNoz MCP 주소를 준다.
# 비우면 그 기능만 꺼진 채로 정상 동작한다.
#   docker compose --profile signoz up -d  로 띄운 뒤
# The container name is signoz-mcp, the port 8080, the endpoint /mcp.
# Bring it up with:  docker compose --profile signoz up -d
# Left empty, the root-cause stage silently degrades to "repository only".
SIGNOZ_MCP_URL=http://signoz-mcp:8080/mcp
SIGNOZ_URL=
SIGNOZ_API_KEY=

# ── Stripe MCP (빌링 알럿 조사용) ──────────────────────────────────
# routes.yml 에서 `mcp: [stripe]` 를 붙인 라우트(=빌링)에만 열린다.
# 실패한 결제의 진실은 트레이스가 아니라 Stripe 에 있어서, 이게 없으면 빌링
# 원인 분석은 "로그상 결제가 실패함" 이상을 못 쓴다.
#
# Stripe 원격 MCP 서버는 API 키를 bearer 로 받는다 — 그래서 브라우저 없는
# 컨테이너에서도 쓸 수 있다(문서가 먼저 안내하는 OAuth 는 못 쓴다).
# STRIPE_MCP_KEY 가 비면 서버 자체가 제공되지 않고, 경고 한 줄 남기고 그냥
# 없이 돈다. /readyz 의 stripeMcp 가 어느 쪽인지 알려준다.
#
# 키는 반드시 **읽기 전용 restricted key** 로 발급할 것 (rk_live_… / rk_test_…).
# 에이전트는 셸을 갖고 있고, 조사에 필요한 권한은 읽기뿐이다.
# https://dashboard.stripe.com/apikeys → Restricted keys → 필요한 리소스만 Read
STRIPE_MCP_URL=https://mcp.stripe.com
STRIPE_MCP_KEY=

# ── GitHub ───────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
ALLOWED_REPOS=sjsh1623/*
DEFAULT_BASE_BRANCH=develop
# 알럿에서 나온 수정은 hotfix/<설명> 브랜치로 나간다 (authentication 의
# docs/branching-strategy.md 가 쓰는 hotfix/* 관례와 맞춘 것).
BRANCH_PREFIX=hotfix
GIT_AUTHOR_NAME=임석현 (Andrew)
GIT_AUTHOR_EMAIL=sjsh1623@flow.team

# ── Claude Code (local install, not the API) ─────────────────
CLAUDE_BIN=claude
# Must be WRITABLE — a read-only mount stalls at the first token refresh.
CLAUDE_HOME=/home/app/.claude
CLAUDE_MODEL=claude-opus-5
CLAUDE_MAX_TURNS=40
CLAUDE_PERMISSION_MODE=acceptEdits
CLAUDE_ALLOWED_TOOLS=Read,Glob,Grep,Edit,Write
# The deny list is what actually keeps the agent out of a shell.
CLAUDE_DISALLOWED_TOOLS=Bash,WebFetch,WebSearch,Task
AGENT_TIMEOUT_MS=900000

# ── Agent backend ────────────────────────────────────────────
# Which agent edits the code: claude | codex. Both are installed in the image,
# so switching is a restart, not a rebuild.
AGENT_PROVIDER=codex

# ── Codex CLI (local install) ────────────────────────────────
CODEX_BIN=codex
# Must be WRITABLE — `codex login` refreshes the session in place.
CODEX_HOME=/home/app/.codex
# Empty = let Codex use its own current default model.
CODEX_MODEL=
# workspace-write confines edits to the worktree and leaves the network off.
# Codex applies patches through a shell, so unlike the Claude driver the sandbox
# is what constrains it — there is no tool deny list to fall back on.
CODEX_SANDBOX=workspace-write
CODEX_REASONING_EFFORT=
# Ignore the host's ~/.codex/config.toml (personal MCP servers, other settings).
CODEX_IGNORE_USER_CONFIG=true
CODEX_EXTRA_ARGS=
# Leave empty when using a `codex login` session (the default). Set it only for
# API-key auth; it is stripped from the agent environment when empty.
OPENAI_API_KEY=

# ── Jobs ─────────────────────────────────────────────────────
# Keep at 1: parallel claude processes contend on the same credential file.
JOB_CONCURRENCY=1
VERIFY_TIMEOUT_MS=600000
WORKSPACE_DIR=./data/work
CACHE_DIR=./data/cache
# 여기에 저장소를 직접 넣어두면 GitHub 에서 clone 하지 않고 그것을 읽는다.
# 없는 저장소는 평소대로 clone 한다. 도커에서는 /data/repo 로 마운트된다.
REPOS_DIR=./repo
DB_PATH=./data/db/morningmate-alert.db
KEEP_WORKSPACE=false

# ── Flow — https://api.flow.team/docs ─────────────────────────
# Node now talks to Flow directly; SigNoz no longer posts there. The pipeline
# uses three documented User API routes:
#   POST  /user/posts/projects/{projectId}/tasks                   업무 등록
#   PATCH /user/posts/projects/{projectId}/tasks/{taskId}/status   업무 상태 수정
#   POST  /user/comments/{postId}                                  댓글 작성
#
# The key is sent as the `x-flow-api-key` header (NOT a bearer token) and is
# issued by an admin at https://flow.team/admin/openapi/keys.
# Empty key or empty project = Flow off; the run still completes and reports
# through the log, SSE and the generic webhook below.
FLOW_API_BASE=https://api.flow.team
FLOW_API_KEY=
# Default board. routes.yml can send an alert to a different one per team with
# `flowProjectId:`, which is what keeps release and billing alerts separate.
FLOW_PROJECT_ID=
# Task lifecycle: registered as NEW, flipped to RUNNING as soon as work starts,
# then DONE, or FAILED when a person has to look at it.
# One of: request | progress | feedback | complete | hold
FLOW_STATUS_NEW=request
FLOW_STATUS_RUNNING=progress
FLOW_STATUS_DONE=complete
FLOW_STATUS_FAILED=feedback
# low | normal | high | urgent
FLOW_TASK_PRIORITY=normal
# Flow ids assigned to every task. Comma separated; empty leaves it unassigned.
FLOW_WORKERS=
# Which stages earn a comment. `triaging` cannot: it runs before the task
# exists, and its output *is* the task body.
FLOW_COMMENT_STAGES=registering,analyzing,editing,verifying,pr_opened,final
# Only override these if Flow renames a route.
FLOW_TASK_CREATE_PATH=
FLOW_TASK_STATUS_PATH=
FLOW_COMMENT_PATH=/user/comments/{postId}

# ── Flow incoming webhooks ───────────────────────────────────
# The key-less way into Flow. An endpoint made in 웹훅 관리 already fixes the
# bot, the action (post / task / chat) and the target project, so all that is
# sent here is {title, text}, authenticated with the x-flow-webhook-token header.
#
# Verified limitation: the response is {"response":{"success":true,"code":200}}
# and carries no ids. It can therefore REGISTER a task but can neither change
# its status nor comment on its thread — every POST makes a new item. Set
# FLOW_API_KEY above for those two, and the code switches to the User API on its
# own (/readyz says which path is live). 60 requests per minute per endpoint.
FLOW_WEBHOOK_URL=
FLOW_WEBHOOK_TOKEN=
#
# Extra named endpoints — one per Flow project or chat room — are picked up as
# FLOW_WEBHOOK_<NAME>_URL / _TOKEN and selected per alert with `flowWebhook:`
# in routes.yml. This is what replaces the relay's team fan-out.
# FLOW_WEBHOOK_BILLING_URL=
# FLOW_WEBHOOK_BILLING_TOKEN=

# ── Triage & root-cause passes (Codex) ───────────────────────
# Two read-only agent passes bracket the edit:
#   alert -> [triage] -> Flow task -> [root cause + SigNoz MCP] -> fix -> PR
# Either failing degrades the run rather than ending it.
TRIAGE_ENABLED=true
# Long enough for a handful of SigNoz queries — that is what fills in
# "where / who / why". Too short and the task body is all "확인되지 않음".
TRIAGE_TIMEOUT_MS=300000
# Whether the triage pass may query SigNoz too. On, because the alert body
# alone cannot answer "where / who / why" and a task that says "확인되지 않음"
# three times is not worth registering. Costs a little time before the task
# appears on the board.
TRIAGE_USE_SIGNOZ_MCP=true
ANALYSIS_ENABLED=true
ANALYSIS_TIMEOUT_MS=600000

# ── Generic webhook (optional, in addition to Flow) ───────────
WEBHOOK_URL=
WEBHOOK_SECRET=
